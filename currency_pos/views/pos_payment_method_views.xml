<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="pos_payment_method_view_form_currency_pos" model="ir.ui.view">
        <field name="name">pos.payment.method.form.currency.pos</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="currency_pos_payment_currency_id"/>
            </xpath>
        </field>
    </record>

    <record id="pos_payment_method_view_tree_currency_pos" model="ir.ui.view">
        <field name="name">pos.payment.method.list.currency.pos</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="currency_pos_payment_currency_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
